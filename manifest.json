{
  "manifest_version": 3,
  "name": "Arxiv PDF Translate",
  "version": "0.5.1",
  "description": "Translate arXiv and local PDFs with the bundled local translation engine and read the bilingual PDF in the browser.",
  "homepage_url": "https://github.com/SheriocCode/arxiv-pdf-translate",
  "key": "",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Arxiv PDF Translate",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/viewer.html",
        "src/vendor/pdf.min.js",
        "src/vendor/pdf.worker.min.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}