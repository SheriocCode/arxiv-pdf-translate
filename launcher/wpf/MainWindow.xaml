<Window x:Class="ArxivPdfTranslateWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arxiv PDF Translate" Height="640" Width="820"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource CustomWindowStyle}">
    <Window.Resources>
        <!-- Lucide icons, converted to WPF path geometry (24x24, stroke style) -->
        <Geometry x:Key="IconGauge">M12 14l4-4 M3.34 19a10 10 0 1 1 17.32 0</Geometry>
        <Geometry x:Key="IconGear">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0 3 3 0 1 1 6 0</Geometry>
        <Geometry x:Key="IconPlay">M6 3l14 9-14 9z</Geometry>
        <Geometry x:Key="IconStop">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z</Geometry>
        <Geometry x:Key="IconMonitor">M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 21h8 M12 17v4</Geometry>
        <Geometry x:Key="IconLogout">M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9</Geometry>
        <Geometry x:Key="IconSave">M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z M17 21v-8H7v8 M7 3v5h8</Geometry>
        <Geometry x:Key="IconReload">M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5</Geometry>
        <Geometry x:Key="IconActivity">M22 12h-4l-3 9L9 3l-3 9H2</Geometry>
        <Geometry x:Key="IconTrash">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6</Geometry>
        <Geometry x:Key="IconList">M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01</Geometry>
        <Geometry x:Key="IconLink">M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71</Geometry>
        <Geometry x:Key="IconUnlink">m18.84 12.25 1.72-1.71h-.02a5.004 5.004 0 0 0-.12-7.07 5.006 5.006 0 0 0-6.95 0l-1.72 1.71 M5.17 11.75l-1.71 1.71a5.004 5.004 0 0 0 .12 7.07 5.006 5.006 0 0 0 6.95 0l1.71-1.71 M8 2v3 M2 8h3 M16 19v3 M19 16h3</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="#E0E0E0" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18,14,18,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Path x:Name="StatusIcon" Width="16" Height="16" Stretch="Uniform"
                  Data="{StaticResource IconUnlink}" Stroke="#8B8B8B" VerticalAlignment="Center"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            <TextBlock x:Name="StatusText" Text="检测中…" Margin="8,0,0,0"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock x:Name="PortText" Text="" Margin="10,0,0,0"
                       VerticalAlignment="Center" Opacity="0.6" />
        </StackPanel>

        <TabControl>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGauge}" />
                        </Viewbox>
                        <TextBlock Text="控制" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,14,0,0">
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="StartButton" Padding="14,5" Click="StartButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}" /></Viewbox>
                                <TextBlock Text="启动服务" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Padding="14,5" Margin="8,0,0,0" Click="StopButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconStop}" /></Viewbox>
                                <TextBlock Text="停止服务" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShortcutButton" Padding="14,5" Margin="20,0,0,0" Click="ShortcutButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconMonitor}" /></Viewbox>
                                <TextBlock Text="创建桌面快捷方式" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <CheckBox x:Name="AutoCheck" Content="开机自启" Margin="20,0,0,0"
                                  VerticalAlignment="Center" Click="AutoCheck_Click" />
                        <Button x:Name="ExitButton" Padding="14,5" Margin="20,0,0,0" Click="ExitButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconLogout}" /></Viewbox>
                                <TextBlock Text="退出" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Opacity="0.55" FontSize="11"
                               Text="关闭窗口会最小化到托盘；右键托盘图标可重新打开或退出。" />
                    <Border BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Background="#141414">
                        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="12" BorderThickness="0" Padding="10" />
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGear}" />
                        </Viewbox>
                        <TextBlock Text="设置" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Width="560" HorizontalAlignment="Center">

                        <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                                CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="模型接口" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="接口地址" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBox x:Name="BaseUrlBox" Grid.Column="1" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模型名称" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBox x:Name="ModelBox" Grid.Column="1" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="API 密钥" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBox x:Name="KeyBox" Grid.Column="1" />
                                    <Button x:Name="ClearKeyButton" Grid.Column="2" Margin="8,0,0,0" Padding="10,4"
                                            Click="ClearKeyButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconTrash}" /></Viewbox>
                                            <TextBlock Text="清除密钥" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="KeyHint" Margin="104,0,0,0" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                                CornerRadius="8" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="翻译选项" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语言" VerticalAlignment="Center" Opacity="0.85" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="SourceCombo" Width="120" />
                                        <TextBlock Text="→" Margin="6,0" VerticalAlignment="Center" Opacity="0.55" />
                                        <ComboBox x:Name="TargetCombo" Width="120" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="默认导出格式" VerticalAlignment="Center" Opacity="0.85" />
                                    <ComboBox x:Name="VariantCombo" Grid.Column="1" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="线程数" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBox x:Name="ThreadsBox" Grid.Column="1" Width="90" HorizontalAlignment="Left" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="服务端口" VerticalAlignment="Center" Opacity="0.85" />
                                    <TextBox x:Name="PortBox" Grid.Column="1" Width="90" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SaveConfigButton" Padding="14,5" Click="SaveConfigButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSave}" /></Viewbox>
                                    <TextBlock Text="保存并重启服务" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReloadConfigButton" Padding="14,5" Margin="8,0,0,0" Click="ReloadConfigButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconReload}" /></Viewbox>
                                    <TextBlock Text="重新载入" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TestConnButton" Padding="14,5" Margin="8,0,0,0" Click="TestConnButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconActivity}" /></Viewbox>
                                    <TextBlock Text="测试连接" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="ConfigResult" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </WrapPanel>

                        <TextBlock Margin="0,12,0,0" Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                                   Text="以上写入本机 server/config.json，供任何前端（浏览器扩展 / Zotero 等）通过 HTTP 接口调用；保存后会自动重启服务。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconList}" />
                        </Viewbox>
                        <TextBlock Text="块" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="任务" VerticalAlignment="Center" Opacity="0.85" />
                        <ComboBox x:Name="JobCombo" Width="320" Margin="8,0,0,0" DisplayMemberPath="Display" />
                        <Button x:Name="RefreshJobsButton" Padding="12,4" Margin="8,0,0,0" Click="RefreshJobsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconReload}" /></Viewbox>
                                <TextBlock Text="刷新" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="JobsInfo" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <DataGrid x:Name="BlockGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="页" Binding="{Binding Page}" Width="50" />
                            <DataGridTextColumn Header="段" Binding="{Binding Index}" Width="50" />
                            <DataGridTextColumn Header="原文" Binding="{Binding Src}" Width="*" />
                            <DataGridTextColumn Header="译文" Binding="{Binding Dst}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
